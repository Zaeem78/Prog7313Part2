<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/navigation_expenses">

    <fragment
        android:id="@+id/navigation_expenses"
        android:name="com.example.budgettingapp.ui.expenses.ExpensesFragment"
        android:label="Expenses">
        <action
            android:id="@+id/action_navigation_expenses_to_view_expense_fragment"
            app:destination="@id/navigation_view_expense">
            <argument
                android:name="expense"
                android:defaultValue="@null"
                app:argType="com.example.budgettingapp.data.Expense"
                app:nullable="true" />
        </action>
    </fragment>

    <fragment
        android:id="@+id/navigation_view_expense"
        android:name="com.example.budgettingapp.ui.expenses.ViewExpenseFragment"
        android:label="View Expense">
        <argument
            android:name="expense"
            android:defaultValue="@null"
            app:argType="com.example.budgettingapp.data.Expense"
            app:nullable="true" />
    </fragment>

    <fragment
        android:id="@+id/navigation_goals"
        android:name="com.example.budgettingapp.ui.goals.GoalsFragment"
        android:label="Goals">
        <action
            android:id="@+id/action_navigation_goals_to_addGoalFragment"
            app:destination="@id/navigation_add_goal">
            <argument
                android:name="goal"
                android:defaultValue="@null"
                app:argType="com.example.budgettingapp.data.Goal"
                app:nullable="true" />
        </action>
    </fragment>

    <fragment
        android:id="@+id/navigation_add_goal"
        android:name="com.example.budgettingapp.ui.goals.AddGoalFragment"
        android:label="Add Goal">
    </fragment>

    <fragment
        android:id="@+id/navigation_profile"
        android:name="com.example.budgettingapp.ui.profile.ProfileFragment"
        android:label="Profile">
        <argument
            android:name="goal"
            android:defaultValue="@null"
            app:argType="com.example.budgettingapp.data.BudgetGoal"
            app:nullable="true" />
    </fragment>
</navigation>
